---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "@/components/shared/Navbar.astro";
import Footer from "@/components/shared/Footer.astro";
import DocProgress from "@/components/docs/DocProgress.astro";

interface Props {
	title: string;
	description?: string;
	accentStyle?: string;
}
const { title, description, accentStyle } = Astro.props;
---

<BaseLayout title={title} description={description} zone="reading">
	<Navbar />
	<DocProgress accentStyle={accentStyle} />
	<div class="pt-[var(--nav-h)]" style={accentStyle}>
		<slot />
	</div>
	<Footer />
	<script>
		import "@/scripts/doc-reader";
		import "@/scripts/code-runner";
		import "@/scripts/arch-explorer";
	</script>
</BaseLayout>
