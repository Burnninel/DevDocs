---
import { Icon } from "astro-icon/components";
import SiteLayout from "@/layouts/SiteLayout.astro";
import Hero from "@/components/home/Hero.astro";
import DocCard from "@/components/home/DocCard.astro";
import { getAllDocs, getDocsGroupedByTech } from "@/lib/docs";
import { techUrl } from "@/lib/paths";

const groups = await getDocsGroupedByTech();
const all = await getAllDocs();
const totalDocs = all.length;
const totalSections = all.reduce((n, d) => n + d.data.sections.length, 0);

const stats = [
	{ value: String(totalDocs), label: "documentações" },
	{ value: String(groups.length), label: "tecnologias" },
	{ value: String(totalSections), label: "seções" },
];
---

<SiteLayout title="DevDocs">
	<Hero
		kicker="biblioteca de consulta"
		title="DevDocs"
		lead="Documentações técnicas foscas e sem ruído — a referência que você abre dezenas de vezes por dia."
		stats={stats}
	>
		<span slot="title">
			Consulta<br />
			<span style="color: var(--color-accent-strong)">sem ruído.</span>
		</span>
	</Hero>

	<div class="mx-auto max-w-7xl px-5 pb-24">
		{
			groups.map(({ tech, meta, docs }) => (
				<section class="scroll-mt-[var(--nav-h)] py-14" id={tech}>
					<div
						class="mb-8 flex flex-wrap items-end justify-between gap-4"
						data-reveal
					>
						<div class="flex items-center gap-4">
							<span
								class="grid size-12 shrink-0 place-items-center rounded-2xl"
								style="background: var(--accent-soft)"
							>
								<Icon
									name={meta.icon}
									class="size-6"
									style="color: var(--color-accent-strong)"
								/>
							</span>
							<div>
								<h2 class="font-display text-3xl font-semibold text-ink">
									{meta.label}
								</h2>
								<p class="mt-1 text-sm text-muted">{meta.tagline}</p>
							</div>
						</div>
						<a
							href={techUrl(tech)}
							class="group flex items-center gap-1.5 font-mono text-xs tracking-wide text-faint transition-colors duration-[var(--dur-fast)] hover:text-accent"
						>
							ver {docs.length} {docs.length === 1 ? "guia" : "guias"}
							<Icon
								name="lucide:arrow-right"
								class="size-3.5 transition-transform duration-[var(--dur-fast)] group-hover:translate-x-0.5"
							/>
						</a>
					</div>

					<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{docs.slice(0, 6).map((entry, i) => (
							<DocCard entry={entry} index={i} />
						))}
					</div>
				</section>
			))
		}
	</div>
</SiteLayout>
