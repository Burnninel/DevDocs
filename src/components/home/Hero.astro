---
interface Props {
	kicker: string;
	title: string;
	lead: string;
	stats?: { value: string; label: string }[];
}
const { kicker, title, lead, stats = [] } = Astro.props;
---

<header class="relative mx-auto max-w-7xl px-5 pt-20 pb-16 sm:pt-28 sm:pb-24">
	<p
		class="font-mono text-sm tracking-widest text-accent uppercase"
		data-reveal
	>
		{kicker}
	</p>
	<h1
		class="mt-5 max-w-4xl font-display text-6xl leading-[0.95] font-semibold text-ink sm:text-8xl"
		data-reveal
	>
		<slot name="title">{title}</slot>
	</h1>
	<p class="mt-7 max-w-xl text-lg text-muted sm:text-xl" data-reveal>
		{lead}
	</p>

	{
		stats.length > 0 && (
			<dl class="mt-12 flex flex-wrap gap-x-12 gap-y-6" data-reveal>
				{stats.map((stat) => (
					<div>
						<dt class="font-display text-3xl font-semibold text-ink">
							{stat.value}
						</dt>
						<dd class="mt-1 font-mono text-xs tracking-wide text-faint uppercase">
							{stat.label}
						</dd>
					</div>
				))}
			</dl>
		)
	}
</header>
