---
import { formatInline } from "@/lib/format";
import type { ContentBlock } from "@/content.config";

type Block = Extract<ContentBlock, { type: "flow-steps" }>;
interface Props {
	block: Block;
}
const { block } = Astro.props;
---

<section class="not-prose glass rounded-2xl p-5">
	{
		block.title && (
			<h4 class="mb-4 font-mono text-xs tracking-widest text-accent uppercase">
				{block.title}
			</h4>
		)
	}
	<ol class="grid gap-4">
		{
			block.steps.map((step, i) => (
				<li class="flex gap-3.5">
					<span
						class="grid size-7 shrink-0 place-items-center rounded-full font-mono text-xs font-semibold"
						style="background: var(--accent-soft); color: var(--color-accent-strong)"
					>
						{i + 1}
					</span>
					<span
						class="wrap-anywhere pt-1 text-sm leading-relaxed text-ink-soft"
						set:html={formatInline(step)}
					/>
				</li>
			))
		}
	</ol>
</section>
