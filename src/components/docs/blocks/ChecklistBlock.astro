---
import { Icon } from "astro-icon/components";
import { formatInline } from "@/lib/format";
import type { ContentBlock } from "@/content.config";

type Block = Extract<ContentBlock, { type: "checklist-block" }>;
interface Props {
	block: Block;
}
const { block } = Astro.props;
---

<section class="not-prose glass rounded-2xl p-5">
	{
		block.title && (
			<h4 class="mb-3 font-mono text-xs tracking-widest text-accent uppercase">
				{block.title}
			</h4>
		)
	}
	<ul class="grid gap-2.5">
		{
			block.items.map((item) => (
				<li class="flex gap-2.5 text-sm leading-relaxed text-ink-soft">
					<Icon
						name="lucide:check"
						class="mt-0.5 size-4 shrink-0"
						style="color: var(--color-tone-good)"
					/>
					<span class="wrap-anywhere" set:html={formatInline(item)} />
				</li>
			))
		}
	</ul>
</section>
